# Copy to .env and adjust. Every value has a working local default in docker-compose.yml.

# --- Credentials (CHANGE for anything beyond local development) ---
MINIO_ROOT_USER=aqiadmin
MINIO_ROOT_PASSWORD=aqiadmin-secret
POSTGRES_USER=aqi
POSTGRES_PASSWORD=aqi
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=change-me-in-production
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Alert delivery (Alertmanager) ---
# Defaults deliver email to the bundled Mailpit inbox (http://localhost:8025) and
# Slack/SMS webhooks to the `alert-sink` echo service (docker compose logs alert-sink).
SMTP_SMARTHOST=mailpit:1025
SMTP_FROM=aqi-alerts@example.org
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_REQUIRE_TLS=false
ALERT_EMAIL_TO=oncall@example.org
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXXXXXX
SLACK_CHANNEL_AQI=#aqi-alerts
SLACK_CHANNEL_PLATFORM=#data-platform-oncall
# Any service accepting the Alertmanager webhook JSON and forwarding SMS (Twilio, SNS, ...)
# SMS_WEBHOOK_URL=https://sms-relay.internal/alertmanager

# --- Streaming / detection tuning ---
AQI_RAW_PARTITIONS=12
ALERT_COOLDOWN_MINUTES=15
ANOMALY_Z_THRESHOLD=4.0
FLINK_TM_SLOTS=4
FLINK_TM_MEMORY=2560m

# --- Simulator ---
SIM_SENSORS=40
SIM_INTERVAL_SECONDS=5
SIM_ANOMALY_RATE=0.002
SIM_EPISODE_RATE=0.5
SIM_MALFORMED_RATE=0.0005

# --- Retention / sizing ---
LANDING_RETENTION_DAYS=90
PROMETHEUS_RETENTION=15d
TRINO_MEMORY_LIMIT=3g
