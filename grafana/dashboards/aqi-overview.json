{
  "uid": "aqi-overview",
  "title": "AQI Overview",
  "tags": [
    "aqi"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "city",
        "label": "City",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(aqi_index, city)",
          "refId": "city"
        },
        "definition": "label_values(aqi_index, city)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "pollutant",
        "label": "Pollutant",
        "type": "custom",
        "query": "pm25,pm10,no2,o3,co2",
        "current": {
          "selected": true,
          "text": "pm25",
          "value": "pm25"
        },
        "options": [
          {
            "selected": true,
            "text": "pm25",
            "value": "pm25"
          },
          {
            "selected": false,
            "text": "pm10",
            "value": "pm10"
          },
          {
            "selected": false,
            "text": "no2",
            "value": "no2"
          },
          {
            "selected": false,
            "text": "o3",
            "value": "o3"
          },
          {
            "selected": false,
            "text": "co2",
            "value": "co2"
          }
        ],
        "multi": false
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "name": "Firing AQI alerts",
        "expr": "ALERTS{alertstate=\"firing\", category=\"aqi\"}",
        "step": "60s",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{city}} {{summary}}",
        "useValueForTime": false
      }
    ]
  },
  "links": [
    {
      "title": "Pipeline health",
      "type": "link",
      "url": "/d/aqi-pipeline",
      "icon": "dashboard"
    }
  ],
  "panels": [
    {
      "id": 1,
